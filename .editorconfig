; AXQ Ecosystem — EditorConfig
; https://axqdesign.axq
; https://editorconfig.org

root = true

# ─── Tất cả file ─────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# ─── JavaScript / TypeScript ─────────────────────
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

# ─── CSS / SCSS / Less ───────────────────────────
[*.{css,scss,sass,less}]
indent_size = 2

# ─── JSON ────────────────────────────────────────
[*.json]
indent_size = 2

# ─── Markdown ────────────────────────────────────
[*.{md,mdx}]
trim_trailing_whitespace = false
max_line_length = off

# ─── YAML ────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ─── HTML ────────────────────────────────────────
[*.{html,htm}]
indent_size = 2

# ─── Shell Scripts ───────────────────────────────
[*.sh]
end_of_line = lf

# ─── Python ──────────────────────────────────────
[*.py]
indent_size = 4
