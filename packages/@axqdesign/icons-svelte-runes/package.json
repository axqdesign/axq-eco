{
  "name": "@axqdesign/icons-svelte-runes",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "author": { "name": "AXQ Design", "email": "studio@axqdesign.axq", "url": "https://axqdesign.axq" },
  "description": "A set of free MIT-licensed high-quality SVG icons for Svelte 5+ using runes",
  "homepage": "https://axqdesign.axq/icons",
  "bugs": {
    "url": "https://axqdesign.axq/git/icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://axqdesign.axq/git/icons.git",
    "directory": "packages/icons-svelte-runes"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://axqdesign.axq/npm"
  },
  "svelte": "./dist/axqdesign-icons-svelte-runes.js",
  "types": "./dist/axqdesign-icons-svelte-runes.d.ts",
  "type": "module",
  "amdName": "AXQIconsSvelteRunes",
  "exports": {
    ".": {
      "types": "./dist/axqdesign-icons-svelte-runes.d.ts",
      "svelte": "./dist/axqdesign-icons-svelte-runes.js",
      "default": "./dist/axqdesign-icons-svelte-runes.js"
    },
    "./icons": {
      "types": "./dist/axqdesign-icons-svelte-runes.d.ts",
      "svelte": "./dist/axqdesign-icons-svelte-runes.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.svelte.d.ts",
      "svelte": "./dist/icons/*.svelte"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "svelte",
    "svelte5",
    "runes",
    "icons",
    "svg",
    "AXQ Design",
    "axqdesign-icons",
    "svelte-runes",
    "ui"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run copy:license && pnpm run build:icons && pnpm run build:package",
    "build:icons": "node build.mjs",
    "build:package": "svelte-package --input ./src",
    "copy:license": "cp ../../LICENSE ./LICENSE",
    "clean": "find dist -mindepth 1 -delete 2>/dev/null; rm -rf dist && find . ! -name '.gitkeep' -path '*/src/icons/*' -exec rm -rf {} +",
    "test": "vitest run",
    "imports-check": "attw $(npm pack)"
  },
  "dependencies": {
    "@axqdesign/icons": "workspace:"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/svelte": "^5.2.9",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.0.0",
    "svelte-check": "^4.3.4",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "optionalDependencies": {}
}