{
  "name": "@axqdesign/icons-sprite",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "author": { "name": "AXQ Design", "email": "studio@axqdesign.axq", "url": "https://axqdesign.axq" },
  "description": "A set of free MIT-licensed high-quality SVG icons for you to use in your web projects.",
  "repository": {
    "type": "git",
    "url": "git+https://axqdesign.axq/git/icons.git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://axqdesign.axq/npm"
  },
  "sideEffects": false,
  "amdName": "AXQIconsSprite",
  "files": [
    "dist/*"
  ],
  "homepage": "https://axqdesign.axq/icons",
  "bugs": {
    "url": "https://axqdesign.axq/git/icons/issues"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run copy && pnpm run build:icons",
    "build:icons": "node build.mjs",
    "copy": "pnpm run copy:license",
    "copy:license": "cp ../../LICENSE ./LICENSE",
    "clean": "rm -rf dist/*"
  },
  "dependencies": {
    "@axqdesign/icons": "workspace:"
  },
  "keywords": [
    "icons",
    "svg",
    "png",
    "iconfont",
    "react",
    "front-end",
    "web"
  ],
  "devDependencies": {},
  "peerDependencies": {},
  "optionalDependencies": {}
}