{
  "name": "@axqdesign/core",
  "version": "1.0.0",
  "description": "AXQ Design System — Admin UI core framework.",
  "homepage": "https://axqdesign.axq",
  "scripts": {
    "dev": "pnpm run watch",
    "dev:prepare": "pnpm run clean && pnpm run copy && concurrently \"pnpm run css:dev\" \"pnpm run js:build\"",
    "build": "pnpm run clean && pnpm run build:assets && pnpm run copy",
    "build:assets": "concurrently \"pnpm run css\" \"pnpm run js\"",
    "clean": "shx rm -rf dist",
    "css": "tsx ../.build/build-css.ts scss dist/css --rtl --minify --banner",
    "css:dev": "tsx ../.build/build-css.ts scss dist/css --rtl",
    "lint": "pnpm run lint:scss && pnpm run lint:scss:vars",
    "lint:scss": "stylelint \"scss/**/*.scss\" --config ../stylelint.config.mjs",
    "lint:scss:fix": "pnpm run lint:scss --fix",
    "lint:scss:vars": "find-unused-sass-variables scss/",
    "js": "pnpm run js:build && pnpm run js:min && pnpm run js:types",
    "js:types": "tsc -p tsconfig.types.json",
    "js:build": "concurrently \"pnpm run js:build:standalone\" \"pnpm run js:build:theme\"",
    "js:build:theme": "cross-env BASE_NAME=axqdesign-theme vite build --config .build/vite.config.mts",
    "js:build:standalone": "cross-env BASE_NAME=AXQ Design vite build --config .build/vite.config.mts",
    "js:min": "concurrently \"pnpm run js:min:standalone\" \"pnpm run js:min:theme\"",
    "js:min:standalone": "concurrently \"terser dist/js/AXQ Design.js --compress --mangle --source-map \\\"content=dist/js/AXQ Design.js.map,filename=dist/js/AXQ Design.min.js.map,url=AXQ Design.min.js.map\\\" -o dist/js/AXQ Design.min.js\" \"terser dist/js/AXQ Design.esm.js --module --compress --mangle --source-map \\\"content=dist/js/AXQ Design.esm.js.map,filename=dist/js/AXQ Design.esm.min.js.map,url=AXQ Design.esm.min.js.map\\\" -o dist/js/AXQ Design.esm.min.js\"",
    "js:min:theme": "concurrently \"terser dist/js/axqdesign-theme.js --compress --mangle --source-map \\\"content=dist/js/axqdesign-theme.js.map,filename=dist/js/axqdesign-theme.min.js.map,url=axqdesign-theme.min.js.map\\\" -o dist/js/axqdesign-theme.min.js\" \"terser dist/js/axqdesign-theme.esm.js --module --compress --mangle --source-map \\\"content=dist/js/axqdesign-theme.esm.js.map,filename=dist/js/axqdesign-theme.esm.min.js.map,url=axqdesign-theme.esm.min.js.map\\\" -o dist/js/axqdesign-theme.esm.min.js\"",
    "copy": "concurrently \"pnpm run copy:img\" \"pnpm run copy:libs\"",
    "copy:img": "shx mkdir -p dist/img && shx cp -rf img/* dist/img",
    "copy:libs": "tsx .build/copy-libs.ts",
    "watch": "concurrently \"pnpm run watch:css\" \"pnpm run watch:js\"",
    "watch:css": "nodemon --watch scss/ --ext scss --exec \"pnpm run css:dev\"",
    "watch:js": "nodemon --watch js/ --ext ts,js --exec \"pnpm run js:build\"",
    "bundlewatch": "bundlewatch",
    "type-check": "tsc --noEmit",
    "test": "concurrently \"pnpm run test:js\" \"pnpm run test:scss\"",
    "test:js": "vitest run",
    "test:scss": "vitest run --config vitest.scss.config.mjs",
    "test:js:watch": "vitest",
    "test:js:coverage": "vitest run --coverage",
    "test:scss:watch": "vitest --config vitest.scss.config.mjs",
    "test:watch": "pnpm run test:js:watch",
    "test:coverage": "pnpm run test:js:coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://axqdesign.axq/git/admin.git"
  },
  "keywords": [
    "css",
    "sass",
    "mobile-first",
    "responsive",
    "front-end",
    "framework",
    "web"
  ],
  "author": {
    "name": "AXQ Design",
    "email": "studio@axqdesign.axq",
    "url": "https://axqdesign.axq"
  },
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://axqdesign.axq/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
